---
import "../styles/terminal.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "studio@luciole-labs ~/prestations",
  description = "Aide et dépannage informatique à domicile, formation pour seniors, installation et ateliers collectifs dans les Hautes-Alpes.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Luciole Labs" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E%F0%9F%96%A5%EF%B8%8F%3C/text%3E%3C/svg%3E"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Thème sauvegardé appliqué avant l'affichage (pas de flash). Sombre par défaut, jamais automatique. -->
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("theme") || "dark";
      } catch (e) {}
    </script>
  </head>
  <body class="crt">
    <slot />

    <script>
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch (e) {}
      });
    </script>
  </body>
</html>
